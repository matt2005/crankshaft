# Crankshaft Configuration for official Raspberry Pi rpi-image-gen Build System
# Copy this file to 'config' and customize as needed

# Basic Image Configuration
IMG_NAME='crankshaft-ng'
IMG_DATE='$(date +%Y-%m-%d)'

# Target Platform Configuration
TARGET_ARCH='arm64'              # arm64 (recommended for Pi 4/5) or armhf (legacy)
DEBIAN_RELEASE='bookworm'        # bookworm (recommended) or bullseye

# Build Configuration
DEPLOY_ZIP=1                     # Create ZIP archive: 1=yes, 0=no

# User Configuration
FIRST_USER_NAME='pi'
FIRST_USER_PASS='raspberry'
ENABLE_SSH=0                     # Enable SSH: 1=yes, 0=no

# Localization
TIMEZONE_DEFAULT='Europe/London'
LOCALE_DEFAULT='en_GB.UTF-8'
KEYBOARD_KEYMAP='gb'
KEYBOARD_LAYOUT='English (UK)'

# WiFi Configuration (optional)
WPA_ESSID=''                     # WiFi network name
WPA_PASSWORD=''                  # WiFi password
WPA_COUNTRY='GB'                 # WiFi country code

# Crankshaft Specific Configuration
ENABLE_HOTSPOT=1                 # Enable WiFi hotspot: 1=yes, 0=no
ENABLE_BLUETOOTH=1               # Enable Bluetooth: 1=yes, 0=no
ENABLE_CAMERA=1                  # Enable camera support: 1=yes, 0=no

# Hardware Configuration
ENABLE_GPIO=1                    # Enable GPIO support: 1=yes, 0=no
ENABLE_I2C=1                     # Enable I2C: 1=yes, 0=no
ENABLE_SPI=1                     # Enable SPI: 1=yes, 0=no

# Performance Settings
GPU_MEM=128                      # GPU memory split (MB)
HDMI_FORCE_HOTPLUG=1            # Force HDMI hotplug: 1=yes, 0=no

# Audio Configuration
ENABLE_PULSEAUDIO=1             # Enable PulseAudio: 1=yes, 0=no
AUDIO_OUTPUT='auto'              # auto, hdmi, analog, both

# Build System Configuration
WORK_DIR='./work'               # Working directory for build files
DEPLOY_DIR='./deploy'           # Output directory for final images

# Advanced Options
VERBOSE=0                       # Enable verbose output: 1=yes, 0=no
CONTINUE=0                      # Continue interrupted build: 1=yes, 0=no
