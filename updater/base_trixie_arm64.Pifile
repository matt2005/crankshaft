#FROM https://downloads.raspberrypi.org/raspios_lite_arm64/images/raspios_lite_arm64-2023-12-11/2023-12-05-raspios-bookworm-arm64-lite.zip
FROM https://github.com/opencardev/crankshaft/releases/download/v.2025.01.01.1/2025-01-01-crankshaft-ng-trixie-arm64.zip
PUMP 1000M

# Update OS and sources
TO /etc/apt/sources.list
deb http://deb.debian.org/debian/ trixie main contrib non-free non-free-firmware
deb http://security.debian.org/debian-security trixie-security main contrib non-free non-free-firmware  
deb http://deb.debian.org/debian/ trixie-updates main contrib non-free non-free-firmware

TO /etc/apt/sources.list.d/raspi.list
deb http://archive.raspberrypi.org/debian/ bookworm main

RUN apt-get update
RUN apt-get -y dist-upgrade

# Install base packages for Trixie
RUN apt-get -y install systemd-resolved systemd-timesyncd
RUN apt-get -y install firmware-linux firmware-linux-nonfree

# Install Qt5 for arm64
RUN apt-get -y install qt5-default qtbase5-dev qtdeclarative5-dev

# Install modern packages available in Trixie
RUN apt-get -y install python3-dev python3-pip python3-setuptools

# TODO: Install Qt5 prebuilt binaries for arm64 architecture
# Note: This requires recompiling Qt5 OpenGLES2 binaries for aarch64
# cat Qt_5151_arm64_OpenGLES2.tar.xz* > Qt5_OpenGLES2.tar.xz
# tar -xf Qt5_OpenGLES2.tar.xz -C /

# Clean up
RUN apt-get clean
RUN rm -rf /var/lib/apt/lists/*
